{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = \"true\" ] && bash \"$CLAUDE_PROJECT_DIR/scripts/cloud-setup.sh\" >&2 || true",
            "timeout": 300,
            "statusMessage": "Installing dependencies and building core..."
          }
        ]
      }
    ]
  }
}
